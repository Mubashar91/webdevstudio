# Copy to .env for local dev, and set the same keys in your Vercel/Netlify
# project settings for production.

# Backend API that receives contact-form enquiries and serves projects.
# REQUIRED in production. If unset, the contact form falls back to mailto:
# and a console error is logged.
VITE_API_URL=http://localhost:5000

# Canonical site origin, no trailing slash. Used for canonical URLs,
# OG tags, sitemap.xml and structured data.
VITE_SITE_URL=https://webdevstudio.me
