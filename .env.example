# ─────────────────────────────────────────────────────────────────────────
# CLIENT-SIDE (VITE_ prefix) — these are inlined into the JS bundle and are
# PUBLIC. Never put a secret here.
# ─────────────────────────────────────────────────────────────────────────

# Backend API for the projects list and the admin panel.
# OPTIONAL. Without it the projects list uses the built-in static data and the
# admin panel won't connect. The contact form does NOT depend on this.
VITE_API_URL=http://localhost:5000

# Canonical site origin, no trailing slash. Used for canonical URLs, OG tags,
# sitemap.xml and structured data. Must be the host that serves 200 — that is
# the www host, since the apex 308-redirects to it.
VITE_SITE_URL=https://www.webdevstudio.me


# ─────────────────────────────────────────────────────────────────────────
# SERVER-SIDE (no VITE_ prefix) — used only by api/contact.js on Vercel.
# These are never shipped to the browser. Set them in
# Vercel → Settings → Environment Variables.
#
# The contact endpoint tries these in order and uses the first one available.
# If none is set it returns 503 and the form falls back to a prefilled mailto.
# ─────────────────────────────────────────────────────────────────────────

# 1. Web3Forms — currently in use. A default key is compiled into
#    api/contact.js, so the form already works without setting this. Set it
#    here to rotate the key without changing code.
# WEB3FORMS_ACCESS_KEY=

# 2. Resend — alternative email delivery.
# RESEND_API_KEY=
# RESEND_FROM=WebDevStudio <hello@webdevstudio.me>
# CONTACT_TO=mmubasharshahzad40@gmail.com

# 3. Your own backend — forwards to <BACKEND_API_URL>/api/requirements.
# BACKEND_API_URL=https://your-backend.example.com
